<% const erros = validationErrors(locals.errors); %>

<h3 class="mt-5">Novo de Processo</h3>

<form action="/processos/novo" method="post">

    <% if (erros.all.length) { %>
        <div class="alert alert-danger">
            <h6>Não foi possível salvar o processo</h6>
            <ul>
                <% erros.all.forEach(mensagem => { %>
                    <li><%= mensagem %></li>
                <% }) %>
            </ul>
        </div> 
    <% } %>

    <div class="form-group mb-3">
        <label for="numero" class="form-label">Número</label>
        <input type="text" class="form-control" name="numero" placeholder="Informe o número do processo">
    </div>

    <div class="form-group mb-3">
        <label for="data" class="form-label">Data</label>
        <input type="date" class="form-control" name="data">
    </div>

    <div class="form-group mb-3">
        <label for="interessado" class="form-label">Interessado</label>
        <input type="text" class="form-control" name="interessado" placeholder="Informe o nome da pessoa interessada">

        <% if (erros.has('interessado')) { %>
            <div class="invalid-feedback d-block">
                <ul>
                    <% erros.get('interessado').forEach(mensagem => { %>
                        <li><small><%= mensagem %></small></li>
                    <% }) %>
                </ul>
            </div>
        <% } %>
    </div>

    <div class="form-group mb-3">
        <label for="assunto" class="form-label">Assunto</label>
        <input type="text" class="form-control" name="assunto" placeholder="Informe o assunto do processo">

        <% if (erros.has('assunto')) { %>
            <div class="invalid-feedback d-block">
                <ul>
                    <% erros.get('assunto').forEach(mensagem => { %>
                        <li><small><%= mensagem %></small></li>
                    <% }) %>
                </ul>
            </div>
        <% } %>
    </div>

    <div class="form-group mb-3">
        <label for="descricao" class="form-label">Descrição</label>
        <textarea class="form-control" name="descricao" id="descricao" cols="30" rows="10" placeholder="Descreva o processo..."></textarea>
    </div>

    <div class="form-group mb-3">
        <button type="submit" class="btn btn-primary mr-2">Salvar Processo</button>
        <a href="/processos" class="btn btn-warning">Cancelar</a>
    </div>

</form>